%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4c081139a167418aa3955b3b18d9004, type: 3}
  m_Name: RaceCatalog
  m_EditorClassIdentifier: Assembly-CSharp::ShiftRush.Core.RaceCatalog
  cars:
  - id: zephyr
    displayName: Zephyr
    tagline: Light, twitchy, loves a jump.
    prefab: {fileID: 618919482974570354, guid: f7cef4fc8817248b58bee806fb810876, type: 3}
    showroomPrefab: {fileID: 0}
    topSpeed: 7
    acceleration: 6
    handling: 7
    boost: 5
    accent: {r: 1, g: 0.2509804, b: 0.8509804, a: 1}
  tracks:
  - id: alpine
    displayName: Alpine Pass
    scene: Track_AlpinePass
    description: Snow, switchbacks and a misty summit. Climb the hairpins, then dive
      through the avalanche gallery.
    lengthKm: 2.5
    thumbnail: {fileID: 21300000, guid: 1edf2f524652c484d801673713f24afe, type: 3}
    loadingTips:
    - Brake before the hairpins, not in them.
    - Hold Left Ctrl for nitro on the gallery straight.
    - R puts you back on your wheels.
  - id: valley
    displayName: Glacier Valley
    scene: Track_GlacierValley
    description: Flat-out sweepers around a glacier lake, over the river bridge and
      through the village.
    lengthKm: 2.3
    thumbnail: {fileID: 21300000, guid: 11edc4d378ba74ad3b189cce8665f941, type: 3}
    loadingTips:
    - Keep it pinned through the lakeside sweepers.
    - The bridge kink is flat out if you're brave.
    - Hold Left Ctrl for nitro.
  - id: arena
    displayName: Test Arena
    scene: TestArena
    description: 'Open ground to learn the car: speed, drifts and jumps.'
    lengthKm: 0
    thumbnail: {fileID: 0}
    loadingTips:
    - Hold Left Ctrl for nitro.
    - R puts you back on your wheels.
    - Steer in the air to line up a landing.

  m_EditorClassIdentifier: Assembly-CSharp::ShiftRush.Race.TrackInfo
  displayName: Downtown Neon
  id: downtown
  description: 'Our city at full width: the neon boulevard, the harbour, the overpass,
    the market chicane and the metro tunnel.'
  loadingTips:
  - The boulevard is the drop zone. Land straight and floor it.
  - The container hairpin at the end of the harbour is the hardest stop on the lap.
  - The chicane is narrow. That's where the cops box you in.
  - The tunnel hides you from the cops for a few seconds.
  laps: 2
  halfWidth: 9
  checkpointSpacing: 140
  route: 0
  smoothing: 1
  snapToGround: 0
  trackWalls: 1
  shiftRamps: 0
